@page "/"
@inject IJSRuntime JSRuntime

<PageTitle>The Wasteland</PageTitle>

<div class="game-container">
    <canvas id="renderCanvas"></canvas>
    
    @if (ShowSplash)
    {
        <div class="splash-overlay">
            <h1 class="splash-title">MAD MAX BLAZOR</h1>
            <h2 class="splash-subtitle">THE WASTELANDS</h2>
            
            <div class="splash-menu">
                @if (HasSave)
                {
                    <button class="menu-btn primary" @onclick="ContinueGame">CONTINUE</button>
                    <button class="menu-btn secondary" @onclick="StartNewGame">NEW GAME</button>
                }
                else
                {
                    <button class="menu-btn primary" @onclick="StartNewGame">START SURVIVAL</button>
                }
            </div>
            
            <div class="splash-footer">
                <p>Use WASD to Drive | Shift for Turbo | E to Loot</p>
            </div>
        </div>
    }
    
    <div class="hud" style="@(ShowSplash ? "display:none;" : "")">
        <h1>THE WASTE</h1>
        <div class="compass-wrapper">
            <div class="compass-strip" id="compassStrip"></div>
            <div class="compass-marker">▼</div>
        </div>
        <p>SPEED: <span id="speedVal">0</span> km/h</p>
        <p>HDG: <span id="hdgVal">0° (N)</span></p>
        <p style="color: red; font-weight: bold;">SIGNAL: <span id="distVal">SEARCHING</span></p>
    </div>
    
    <div class="hud-right">
        <p>SCRAP: <span id="scrapVal" style="color: gold;">0</span></p>
    </div>

    <div class="hud-bottom">
        <div class="speed-slider-container">
            <span class="slider-label">SPEED LIMIT</span>
            <!-- Range 1 to 100. Default 50. -->
            <input type="range" min="1" max="100" value="50" class="slider" id="speedSlider" 
                   oninput="window.wastelandRenderer.setSpeedRatio(this.value)">

            <span class="slider-label" style="margin-top: 10px;">BANDIT SPEED</span>
            <!-- Default 35% to match current 35 units of 100 -->
            <input type="range" min="1" max="100" value="35" class="slider" id="enemySpeedSlider" 
                   oninput="window.wastelandRenderer.setEnemySpeedRatio(this.value)">
        </div>

        <div class="fuel-bar-container">
            <div class="fuel-bar" id="fuelBar" style="width: 100%;"></div>
            <span class="fuel-label">FUEL</span>
        </div>
    </div>

    @if (ShowPaperdoll)
    {
        <div class="paperdoll-overlay">
            <div class="paperdoll-window wide">
                <div class="paperdoll-header">
                    <h2>SURVIVOR SHEET</h2>
                    <button class="close-btn" @onclick="TogglePaperdoll">×</button>
                </div>
                
                <div class="paperdoll-content">
                    <div class="stats-card">
                        <h3>LEVEL @State.Level</h3>
                        <div class="xp-bar-container">
                             @{ var xpPct = (double)State.XP / State.GetXPToNextLevel() * 100; }
                            <div class="xp-bar" style="width: @(Math.Min(100, xpPct))%;"></div>
                        </div>
                        <p class="xp-text">XP: @State.XP / @State.GetXPToNextLevel()</p>
                        
                        <div class="stat-points">
                            @if (State.StatPoints > 0)
                            {
                                <span class="points-glow">POINTS AVAILABLE: @State.StatPoints</span>
                            }
                        </div>

                        <div class="stats-list">
                            @renderStat("STR", State.GetTotalStat("STR"))
                            @renderStat("DEX", State.GetTotalStat("DEX"))
                            @renderStat("CON", State.GetTotalStat("CON"))
                            @renderStat("INT", State.GetTotalStat("INT"))
                            @renderStat("WIS", State.GetTotalStat("WIS"))
                            @renderStat("CHA", State.GetTotalStat("CHA"))
                            <div class="stat-row scrap-row" style="margin-top: 15px; border-top: 1px solid #333; padding-top: 10px;">
                                <span class="stat-name" style="color: gold; width: 80px;">SCRAP</span>
                                <span class="stat-val" style="color: gold;">@State.Scrap</span>
                            </div>
                        </div>
                    </div>

                    <div class="equipment-card">
                        <h3>EQUIPMENT</h3>
                        <div class="equip-grid">
                            @foreach (var slot in new[] { "HEAD", "CHEST", "BACK", "LEGS", "FEET", "MAIN", "OFF", "GLOVES" })
                            {
                                <div class="equip-slot" @onclick="() => Unequip(slot)">
                                    <span class="slot-label">@slot</span>
                                    @if (State.Equipment.ContainsKey(slot) && State.Equipment[slot] != null)
                                    {
                                        <div class="item-icon">@State.Equipment[slot].GetIcon()</div>
                                        <div class="item-name">@State.Equipment[slot].Name</div>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    <div class="inventory-card">
                        <h3>INVENTORY</h3>
                        <div class="inv-scroll">
                            @foreach (var item in State.Inventory)
                            {
                                <div class="inv-item" @onclick="() => Equip(item)">
                                    <span class="item-icon">@item.GetIcon()</span>
                                    <span class="item-name">@item.Name</span>
                                    @if (item.Slot != "NONE") { <span class="equip-hint">(Equip)</span> }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (ShowShop)
    {
        <div class="shop-overlay">
            <div class="shop-window">
                <div class="shop-header">
                    <h2>WASTELAND TRADER</h2>
                    <button class="close-btn" @onclick="CloseShop">×</button>
                </div>
                <div class="shop-content">
                    <p class="scrap-total">SCRAP: <span style="color: gold;">@State.Scrap</span></p>
                    <div class="shop-grid">
                        @foreach (var item in ShopItems)
                        {
                            <div class="shop-item @(State.Scrap >= item.Cost ? "" : "locked")" @onclick="() => BuyItem(item)">
                                <div class="item-icon">@item.GetIcon()</div>
                                <div class="item-info">
                                    <span class="item-name">@item.Name</span>
                                    <span class="item-cost">@item.Cost Scrap</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    @if (ShowLevelUp)
    {
        <div class="level-up-popup">
            <h1>LEVEL UP!</h1>
            <p>CONGRATULATIONS, SURVIVOR!</p>
            <p style="color: gold;">+2 STAT POINTS AWARDED</p>
        </div>
    }

    @if (State.IsDead)
    {
        <div class="death-overlay">
            <div class="death-content">
                <h1 class="death-title">YOU DIED</h1>
                <p>The Wasteland claims another soul...</p>
                <button class="revive-btn" @onclick="HandleRevive">REVIVE</button>
            </div>
        </div>
    }
</div>

@code {
    RenderFragment renderStat(string name, int val) => __builder => {
        <div class="stat-row">
            <span class="stat-name">@name</span>
            <span class="stat-val">@val</span>
            @if (State.StatPoints > 0)
            {
                <button class="plus-btn" @onclick='() => AllocatePoint(name)'>+</button>
            }
        </div>
    };
}

<script>
    window.updateHud = (speed, dist, hdgRad, fuel, scrap) => {
        document.getElementById('speedVal').innerText = speed;
        document.getElementById('distVal').innerText = dist + "m";
        
        // Scrap
        if (scrap !== undefined) {
             document.getElementById('scrapVal').innerText = scrap;
        }

        // Fuel
        if (fuel !== undefined) {
             document.getElementById('fuelBar').style.width = fuel + "%";
             if (fuel < 20) document.getElementById('fuelBar').style.backgroundColor = "red";
             else document.getElementById('fuelBar').style.backgroundColor = "#ffcc00";
        }

        // Visual Compass Update (2px per degree)
        // Deg = rad * 180 / PI
        // Offset = -Deg * 2
        var deg = hdgRad * (180 / Math.PI);
        var offset = -deg * 2;
        // Center text is at 0, which is "N". Center of div is at 200px.
        // If we want "N" (0 deg) to be at center, offset should be 0 assuming back-pos-x works that way?
        // Actually, usually background-position 0 starts at left edge.
        // To center 0 deg (N) at 200px (center of 400px div):
        // Offset = 200 - (deg * 2).
        var finalPos = 200 + offset;
        document.getElementById('compassStrip').style.backgroundPositionX = finalPos + "px";
    };
</script>

<style>
    body, html { overflow: hidden; height: 100%; margin: 0; background: #222; }
    .game-container { position: relative; width: 100%; height: 100vh; }
    #renderCanvas { width: 100%; height: 100%; touch-action: none; outline: none; }
    
    .hud {
        position: absolute;
        top: 20px;
        left: 20px;
        color: orange;
        font-family: 'Courier New', monospace;
        text-shadow: 2px 2px 0 #000;
        pointer-events: none;
        width: 100%; /* Full width for centering stuff if needed */
    }

    .compass-wrapper {
        position: fixed;
        top: 20px;
        left: 50%;
        transform: translateX(-50%);
        width: 400px;
        height: 40px;
        background: rgba(0,0,0,0.6);
        border: 2px solid #555;
        border-radius: 4px;
        overflow: hidden;
        pointer-events: none;
    }

    .compass-strip {
        width: 100%;
        height: 100%;
        /* 720px wide image: 0=N, 180=E, 360=S, 540=W. 2px per degree */
        background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='720' height='40' viewBox='0 0 720 40'><text x='0' y='30' fill='white' font-family='monospace' font-weight='bold' text-anchor='middle'>N</text><rect x='90' y='10' width='2' height='10' fill='gray'/><text x='180' y='30' fill='white' font-family='monospace' font-weight='bold' text-anchor='middle'>E</text><rect x='270' y='10' width='2' height='10' fill='gray'/><text x='360' y='30' fill='white' font-family='monospace' font-weight='bold' text-anchor='middle'>S</text><rect x='450' y='10' width='2' height='10' fill='gray'/><text x='540' y='30' fill='white' font-family='monospace' font-weight='bold' text-anchor='middle'>W</text><rect x='630' y='10' width='2' height='10' fill='gray'/><text x='720' y='30' fill='white' font-family='monospace' font-weight='bold' text-anchor='middle'>N</text></svg>");
        background-repeat: repeat-x;
    }

    .compass-marker {
        position: absolute;
        top: 0;
        left: 50%;
        transform: translateX(-50%);
        color: red;
        font-size: 20px;
        line-height: 20px;
    }

    .hud-right {
        position: absolute;
        top: 20px;
        right: 20px;
        color: white;
        font-family: 'Courier New', monospace;
        text-shadow: 2px 2px 0 #000;
        font-size: 24px;
        font-weight: bold;
        pointer-events: none;
    }

    .hud-bottom {
        position: absolute;
        bottom: 20px;
        right: 20px;
        width: 300px;
        pointer-events: auto; /* Allow slider interaction */
    }

    .speed-slider-container {
        width: 100%;
        margin-bottom: 10px;
        background: rgba(0,0,0,0.6);
        padding: 5px;
        border: 1px solid #555;
        color: white;
        font-family: 'Courier New', monospace;
        text-align: center;
    }

    .slider {
        width: 90%;
        cursor: pointer;
    }

    .slider-label {
        display: block;
        font-size: 14px;
        margin-bottom: 5px;
        color: #ffcc00;
        font-weight: bold;
    }

    .fuel-bar-container {
        width: 100%;
        height: 30px;
        background: #333;
        border: 2px solid #555;
        position: relative;
    }

    .fuel-bar {
        height: 100%;
        background: #ffcc00; /* Fuel Color */
        transition: width 0.2s;
    }

    .fuel-label {
        position: absolute;
        width: 100%;
        text-align: center;
        top: 2px;
        color: black;
        font-weight: bold;
        font-family: sans-serif;
    }

    /* Splash Screen Styles */
    .splash-overlay {
        position: absolute;
        top: 0; left: 0; width: 100%; height: 100%;
        background: rgba(0, 0, 0, 0.7);
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        z-index: 100;
        backdrop-filter: blur(5px);
    }

    .splash-title {
        font-family: 'Impact', sans-serif;
        font-size: 80px;
        color: #ffcc00;
        text-shadow: 4px 4px 0 #000;
        margin-bottom: 0;
        letter-spacing: 5px;
    }

    .splash-subtitle {
        font-family: 'Courier New', monospace;
        font-size: 30px;
        color: #fff;
        margin-top: 10px;
        margin-bottom: 50px;
        letter-spacing: 10px;
        text-transform: uppercase;
        border-bottom: 2px solid #ffcc00;
        padding-bottom: 10px;
    }

    .menu-btn {
        display: block;
        width: 300px;
        padding: 15px;
        margin: 15px;
        font-family: 'Courier New', monospace;
        font-size: 24px;
        font-weight: bold;
        cursor: pointer;
        border: 2px solid #ffcc00;
        background: rgba(0,0,0,0.8);
        color: #ffcc00;
        text-transform: uppercase;
        transition: all 0.2s;
    }

    .menu-btn:hover {
        background: #ffcc00;
        color: #000;
        transform: scale(1.05);
    }

    .menu-btn.secondary {
        border-color: #555;
        color: #aaa;
    }
    
    .menu-btn.secondary:hover {
        background: #555;
        color: #fff;
    }

    .splash-footer {
        position: absolute;
        bottom: 30px;
        color: #888;
        font-family: sans-serif;
    }

    /* Paperdoll Styles */
    .paperdoll-overlay {
        position: absolute;
        top: 0; left: 0; width: 100%; height: 100%;
        background: rgba(0,0,0,0.8);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 200;
        backdrop-filter: blur(8px);
    }
    .paperdoll-window {
        width: 600px;
        background: #1a1a1a;
        border: 3px solid #ffcc00;
        box-shadow: 0 0 30px rgba(255, 204, 0, 0.3);
        padding: 20px;
        color: white;
        font-family: 'Courier New', monospace;
    }
    .paperdoll-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 2px solid #333;
        margin-bottom: 20px;
        padding-bottom: 10px;
    }
    .paperdoll-header h2 { margin: 0; color: #ffcc00; letter-spacing: 5px; }
    .close-btn { 
        background: none; border: none; color: #555; font-size: 32px; cursor: pointer;
    }
    .close-btn:hover { color: #ffcc00; }
    .paperdoll-content { display: flex; gap: 20px; }
    .stats-card, .inventory-card { flex: 1; background: #222; padding: 15px; border: 1px solid #333; }
    
    .xp-bar-container { width: 100%; height: 10px; background: #000; margin: 10px 0; border: 1px solid #444; }
    .xp-bar { height: 100%; background: #00ccff; }
    .xp-text { font-size: 12px; color: #888; margin-bottom: 15px; }
    
    .stat-row { 
        display: flex; align-items: center; margin-bottom: 10px; font-size: 18px; 
    }
    .stat-name { width: 50px; color: #aaa; }
    .stat-val { width: 40px; font-weight: bold; }
    .plus-btn { 
        padding: 2px 8px; background: #ffcc00; border: none; font-weight: bold; cursor: pointer;
        border-radius: 2px;
    }
    .plus-btn:hover { background: #fff; }
    .points-glow { color: #00ccff; font-weight: bold; text-shadow: 0 0 10px #00ccff; display: block; margin-bottom: 15px; }

    .inv-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
    .inv-slot.gear { border-style: solid; color: #666; }

    /* Shop Styles */
    .shop-overlay {
        position: absolute;
        top: 0; left: 0; width: 100%; height: 100%;
        background: rgba(0,0,0,0.85);
        display: flex; justify-content: center; align-items: center;
        z-index: 400; backdrop-filter: blur(10px);
    }
    .shop-window {
        width: 500px; background: #1a1a1a; border: 3px solid gold;
        padding: 20px; color: white; font-family: 'Courier New', monospace;
    }
    .shop-header { display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #333; margin-bottom: 20px; }
    .scrap-total { font-size: 24px; font-weight: bold; margin-bottom: 20px; text-align: center; border: 1px solid #444; padding: 10px; }
    .shop-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; }
    .shop-item { 
        background: #222; border: 1px solid #444; padding: 10px; display: flex; align-items: center; gap: 10px; cursor: pointer; transition: all 0.2s;
    }
    .shop-item:hover { border-color: gold; background: #333; }
    .shop-item.locked { opacity: 0.5; cursor: default; }
    .item-info { display: flex; flex-direction: column; }
    .item-cost { color: gold; font-size: 14px; }

    /* Paperdoll Extended */
    .paperdoll-window.wide { width: 800px; }
    .equipment-card, .inventory-card { flex: 1; background: #222; padding: 15px; border: 1px solid #333; }
    .equip-grid { display: grid; grid-template-columns: 1fr; gap: 10px; }
    .equip-slot { 
        height: 60px; background: #111; border: 1px solid #444; display: flex; flex-direction: column; align-items: center; justify-content: center; position: relative; cursor: pointer;
    }
    .slot-label { position: absolute; top: 2px; left: 5px; font-size: 10px; color: #555; }
    .inv-scroll { height: 300px; overflow-y: auto; }
    .inv-item { 
        padding: 8px; border-bottom: 1px solid #333; cursor: pointer; display: flex; gap: 10px; align-items: center;
    }
    .inv-item:hover { background: #333; }
    .equip-hint { font-size: 10px; color: #00ccff; }

    /* Level Up Popup */
    .level-up-popup {
        position: absolute;
        top: 30%; left: 50%; transform: translate(-50%, -50%);
        background: rgba(0,0,0,0.9);
        border: 4px solid gold;
        padding: 40px;
        text-align: center;
        z-index: 300;
        animation: popupIn 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    @@keyframes popupIn {
        from { transform: translate(-50%, -50%) scale(0); opacity: 0; }
        to { transform: translate(-50%, -50%) scale(1); opacity: 1; }
    }

    /* Death Overlay */
    .death-overlay {
        position: absolute;
        top: 0; left: 0; width: 100%; height: 100%;
        background: rgba(139, 0, 0, 0.4);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 500;
        backdrop-filter: grayscale(1) blur(10px);
        animation: fadeIn 2s forwards;
    }
    .death-content {
        text-align: center;
        color: white;
        font-family: 'Courier New', monospace;
    }
    .death-title {
        font-size: 80px;
        color: #ff3300;
        text-shadow: 0 0 20px #000;
        margin-bottom: 20px;
        letter-spacing: 15px;
    }
    .revive-btn {
        padding: 15px 40px;
        font-size: 24px;
        background: #000;
        color: #ff3300;
        border: 3px solid #ff3300;
        cursor: pointer;
        transition: all 0.3s;
        letter-spacing: 5px;
    }
    .revive-btn:hover {
        background: #ff3300;
        color: #000;
        box-shadow: 0 0 30px #ff3300;
    }
    @@keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }
</style>

@code {
    private DotNetObjectReference<Home>? objRef;
    private bool ShowSplash { get; set; } = true;
    private bool ShowPaperdoll { get; set; } = false;
    private bool ShowLevelUp { get; set; } = false;
    private bool ShowShop { get; set; } = false;
    private bool HasSave { get; set; } = false;

    private List<MadMaxBlazor.Services.Item> ShopItems = new List<MadMaxBlazor.Services.Item>()
    {
        new MadMaxBlazor.Services.Item { Name = "Spiked Helmet", Slot = "HEAD", Cost = 50, BonusCon = 2 },
        new MadMaxBlazor.Services.Item { Name = "Scrap Plate", Slot = "CHEST", Cost = 150, BonusCon = 5 },
        new MadMaxBlazor.Services.Item { Name = "Rust-Back Tank", Slot = "BACK", Cost = 120, BonusStr = 2 },
        new MadMaxBlazor.Services.Item { Name = "Spiked Boots", Slot = "FEET", Cost = 60, BonusDex = 2 },
        new MadMaxBlazor.Services.Item { Name = "Motor Goggles", Slot = "HEAD", Cost = 30, BonusDex = 2 },
        new MadMaxBlazor.Services.Item { Name = "Sawed Off", Slot = "MAIN", Cost = 250, BonusStr = 4 },
        new MadMaxBlazor.Services.Item { Name = "Machete", Slot = "MAIN", Cost = 100, BonusStr = 2 },
        new MadMaxBlazor.Services.Item { Name = "Buckler", Slot = "OFF", Cost = 80, BonusCon = 2 },
        new MadMaxBlazor.Services.Item { Name = "Leather Chaps", Slot = "LEGS", Cost = 70, BonusDex = 3 },
        new MadMaxBlazor.Services.Item { Name = "Welder's Gloves", Slot = "GLOVES", Cost = 40, BonusDex = 2 }
    };

    [Inject] MadMaxBlazor.Services.GameState State { get; set; } = default!;
    [Inject] MadMaxBlazor.Services.PersistenceService Persistence { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        State.OnChange += StateHasChanged;
        State.OnLevelUp += HandleLevelUp;
        
        var savedState = await Persistence.LoadGame();
        if (savedState != null)
        {
            HasSave = true;
        }
    }

    private async void HandleLevelUp()
    {
        ShowLevelUp = true;
        StateHasChanged();
        await Task.Delay(4000);
        ShowLevelUp = false;
        StateHasChanged();
    }

    private void TogglePaperdoll()
    {
        ShowPaperdoll = !ShowPaperdoll;
        StateHasChanged();
    }

    [JSInvokable]
    public void TogglePaperdollFromJS()
    {
        TogglePaperdoll();
    }

    [JSInvokable]
    public void OpenShop()
    {
        ShowShop = true;
        StateHasChanged();
    }

    private void CloseShop()
    {
        ShowShop = false;
        StateHasChanged();
    }

    private async void BuyItem(MadMaxBlazor.Services.Item item)
    {
        if (State.Scrap >= item.Cost)
        {
            State.BuyItem(item);
            await Persistence.SaveGame(State);
            StateHasChanged();
        }
    }

    private async void Equip(MadMaxBlazor.Services.Item item)
    {
        State.EquipItem(item);
        await Persistence.SaveGame(State);
        StateHasChanged();
    }

    private async void Unequip(string slot)
    {
        State.UnequipItem(slot);
        await Persistence.SaveGame(State);
        StateHasChanged();
    }

    private async void AllocatePoint(string stat)
    {
        if (State.StatPoints <= 0) return;
        
        switch(stat)
        {
            case "STR": State.Strength++; break;
            case "DEX": State.Dexterity++; break;
            case "CON": State.Constitution++; break;
            case "INT": State.Intelligence++; break;
            case "WIS": State.Wisdom++; break;
            case "CHA": State.Charisma++; break;
        }
        State.StatPoints--;
        await Persistence.SaveGame(State);
        StateHasChanged();
    }

    private async void HandleRevive()
    {
        State.Revive();
        await JSRuntime.InvokeVoidAsync("wastelandRenderer.respawnPlayer");
        StateHasChanged();
    }

    [JSInvokable]
    public async Task NotifyDeath()
    {
        State.UpdateHealth(0);
        await Persistence.SaveGame(State);
        StateHasChanged();
    }

    private async Task ContinueGame()
    {
        var savedState = await Persistence.LoadGame();
        if (savedState != null)
        {
            State.LoadFrom(savedState);
        }
        ShowSplash = false;
    }

    private async Task StartNewGame()
    {
        await Persistence.ClearSave();
        State.Reset();
        ShowSplash = false;
    }

    private void StartSinglePlayer()
    {
        ShowSplash = false;
    }

    private void StartMultiplayer()
    {
        // No Op
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            objRef = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("wastelandRenderer.init", "renderCanvas", objRef);
        }
    }

    [JSInvokable]
    public async Task AddExperience(int amount)
    {
        State.AddXP(amount);
        await Persistence.SaveGame(State);
    }

    [JSInvokable]
    public async Task AddScrap(int amount)
    {
        State.AddScrap(amount);
        await Persistence.SaveGame(State);
    }

    public void Dispose()
    {
        State.OnChange -= StateHasChanged;
        State.OnLevelUp -= HandleLevelUp;
        objRef?.Dispose();
    }
}
